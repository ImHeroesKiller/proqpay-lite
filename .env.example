# ProQPay Lite — Environment Variables
# Copy to .env.local for local dev. On Netlify, set via Site settings → Environment variables.
# Never commit real secrets.

# ── Database (Netlify / Neon Postgres) ──
# Connection string from Netlify DB or Neon dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Aliases also supported by netlify/functions/db.mjs:
# NETLIFY_DATABASE_URL=
# POSTGRES_URL=
# NEON_DATABASE_URL=

# ── Optional Gemini (local / non-static only) ──
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
