# ProQPay Lite — Cloudflare-native local environment example
# Never commit real secrets. Production bindings and variables are managed in
# Cloudflare Pages; this file is documentation for local development only.

DEFAULT_ORG_ID=ORG-OTSINDO
DATA_BACKEND=d1
AUTH_MODE=session
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
WORKERS_AI_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
EMPLOYEE_SESSION_HOURS=12
EMPLOYEE_PORTAL_ORIGINS=https://proqpay-ess.arywibowo.workers.dev

# Billing business date boundary. Used for evidence dates so an Indonesia-local
# date after midnight is not rejected merely because UTC is still on yesterday.
BILLING_TIME_ZONE=Asia/Jakarta

# Payment Gateway — fail closed until a real provider adapter is implemented.
PAYMENT_GATEWAY_PROVIDER=UNCONFIGURED
PAYMENT_GATEWAY_ALLOW_MOCK=false

# E2Pay B2B Disbursement — set PAYMENT_GATEWAY_PROVIDER=E2PAY after UAT.
# Credentials must be stored as Cloudflare Secrets in production.
E2PAY_ENV=UAT
E2PAY_TIMEOUT_MS=15000
E2PAY_MAX_SYNC_BENEFICIARIES=25
# E2PAY_CLIENT_ID=
# E2PAY_CLIENT_SECRET=
# E2PAY_USERNAME=
# E2PAY_PASSWORD_MD5=
# E2PAY_ACCOUNT_SRC=
# E2PAY_SOURCE_ID=

# Hosted Payment / Hosted Checkout — disabled independently from Seamless.
PAYMENT_GATEWAY_HOSTED_ENABLED=false
PAYMENT_GATEWAY_HOSTED_TTL_SECONDS=900
PAYMENT_GATEWAY_HOSTED_RETURN_PREFIXES=/,/operations,/payments
# UAT MOCK only. Must point to a controlled hosted-checkout simulator.
# PAYMENT_GATEWAY_MOCK_HOSTED_ORIGIN=

# Production secrets (configure in Cloudflare Pages, leave blank locally):
# PI_ENCRYPTION_KEY=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=
# PROQPAY_BOOTSTRAP_ADMIN_EMAIL=
# PROQPAY_BOOTSTRAP_ADMIN_PASSWORD=
# EMPLOYEE_PORTAL_KEY=

# Optional external web-search fallback for IDA; inference remains Workers AI.
# TAVILY_API_KEY=