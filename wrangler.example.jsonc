{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proqpay-lite",
  "compatibility_date": "2026-08-21",
  "pages_build_output_dir": "./out",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proqpay-lite-production",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "proqpay-lite-files" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "DEFAULT_ORG_ID": "ORG-OTSINDO",
    "DATA_BACKEND": "d1",
    "AUTH_MODE": "session",
    "EMPLOYEE_SESSION_HOURS": "12",
    "EMPLOYEE_PORTAL_ORIGINS": "https://proqpay-ess.arywibowo.workers.dev",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  }
}
