{
  "name": "proqpay-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "cloudflare:preflight": "node scripts/cloudflare-native-preflight.mjs",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:inventory:d1": "wrangler d1 list",
    "cloudflare:inventory:r2": "wrangler r2 bucket list",
    "cloudflare:inventory:pages": "wrangler pages project list",
    "cloudflare:d1:migrate:local": "wrangler d1 migrations apply proqpay-lite-production --local",
    "cloudflare:d1:migrate:remote": "wrangler d1 migrations apply proqpay-lite-production --remote",
    "export": "next build"
  },
  "dependencies": {
    "jose": "^6.2.4",
    "next": "^16.2.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5.8.0",
    "wrangler": "^4.125.0"
  }
}
